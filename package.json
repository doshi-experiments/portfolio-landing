{
  "name": "portfolio-landing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "rishabhdoshi.com \u2014 one portfolio, twelve design movements",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:fixtures": "DEV_FIXTURES=1 astro dev",
    "build": "astro build",
    "build:fixtures": "DEV_FIXTURES=1 astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tools/tsconfig.json && npm run --silent contrast",
    "contrast": "node --import ./tools/lib/register.mjs tools/contrast.mjs",
    "sheet": "node tools/sheet.mjs",
    "firstpaint": "node tools/firstpaint.mjs",
    "switching": "node tools/switching.mjs",
    "peek": "node tools/lib/peek.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/josefin-sans": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@types/node": "24.13.4",
    "astro": "7.3.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  }
}
