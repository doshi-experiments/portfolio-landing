{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "..",
    "paths": {
      "@design/*": [
        "src/design/*"
      ],
      "@content/*": [
        "src/content/*"
      ],
      "@client/*": [
        "src/client/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "*.mjs",
    "lib/*.mjs",
    "lib/*.d.ts"
  ]
}
