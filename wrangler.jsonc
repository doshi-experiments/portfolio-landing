{
  // Cloudflare Worker serving only static assets — no server code.
  // `npm run build` writes dist/, and Wrangler uploads it.
  //
  // The Worker is named `wip`, which is what it has always been called in the
  // dashboard — NOT `portfolio-landing`. Renaming it here would create a
  // second Worker and leave rishabhdoshi.com pointing at the old one.
  //
  // This file did not exist before. Without it the build had nothing telling
  // it which directory to upload, so it published a version that quietly kept
  // the previous assets: a green deploy serving the old site.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wip",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./dist"
  }
}
